@page "/"

@if (Products is null)
{
    <Loading />
}
else
{
    <MudPaper Class="p-3 mb-3" Elevation="1" Style="border-radius:12px;">
        <div class="d-flex justify-content-between align-items.center">
            <!-- Filtro -->
            <div class="ms-3">
                <FilterComponent ApplyFilter="ApplyFilterAsync" />
            </div>

            <!-- Paginación -->
            <div class="d-flex align-items-center gap-2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(currentPage == 1)"
                           OnClick="() => SelectedPageAsync(currentPage - 1)">
                    Anterior
                </MudButton>

                <MudText Typo="Typo.subtitle2">@currentPage / @totalPages</MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(currentPage == totalPages)"
                           OnClick="() => SelectedPageAsync(currentPage + 1)">
                    Siguiente
                </MudButton>
            </div>
        </div>
    
    </MudPaper>

    <!-- Grid de productos -->
    <MudGrid GutterSize="3">
        @foreach (var product in Products!)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="h-100">

                        <MudCardMedia Image="@product.MainImage"
                                      title="@product.Name" 
                                      Height= "150">                               
                          </MudCardMedia>

                    <MudCardContent>
                        <MudText Typo="Typo.h6">@product.Name</MudText>
                        <MudText Typo="Typo.body2" Class="text-muted">@product.Description</MudText>
                        <MudText Typo="Typo.subtitle1" Class="mt-2 fw-bold">
                            @($"{product.Price:C2}")
                        </MudText>
                    </MudCardContent>

                    <MudCardActions Class="d-flex justify-content-center gap-2 mb-2">
                         <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   Href="@($"/products/details/{product.Id}")">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Class="me-1" />
                            Detalles
                        </MudButton> 

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="@(() => AddToCartAsync(product.Id))">
                            <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Class="me-1" />
                            Agregar
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

}

