@page "/Cart/ModifyTemporalOrder/{TemporalOrderId:int}"

@if (loading)
{
    <Loading />
}
else
{
   <MudCard Class="pa-4">

    <!-- HEADER -->
    <MudCardHeader>
        <MudGrid>
            <MudItem xs="8">
                <MudText Typo="Typo.h5">
                    <MudIcon Icon="@Icons.Material.Filled.Star" Class="mr-2" />
                    @product!.Name
                </MudText>
            </MudItem>

            <MudItem xs="4" Class="d-flex justify-end">
                <MudButton Color="Color.Success"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Href="/">
                    Regresar
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudCardHeader>

    <!-- BODY -->
    <MudCardContent>

        <MudGrid>

            <!-- COLUMNA IZQUIERDA -->
            <MudItem xs="12" md="6">

                <MudText Typo="Typo.subtitle1" Class="mt-3">Nombre:</MudText>
                <MudText Typo="Typo.body1" Class="mb-3"><b>@product.Name</b></MudText>

                <MudText Typo="Typo.subtitle1">Descripción:</MudText>
                <MudText Typo="Typo.body1" Class="mb-3"><b>@product.Description</b></MudText>

                <MudText Typo="Typo.subtitle1">Precio:</MudText>
                <MudText Typo="Typo.body1" Class="mb-3"><b>@($"{product.Price:C2}")</b></MudText>

                <MudText Typo="Typo.subtitle1">Inventario:</MudText>
                <MudText Typo="Typo.body1" Class="mb-3"><b>@($"{product.Stock:N2}")</b></MudText>

                <MudText Typo="Typo.subtitle1">Categorías:</MudText>

                    <MudChipSet T="string" Class="mb-3" ReadOnly="true" MultiSelection="false">
                        @foreach (var category in categories!)
                        {
                            <MudChip T="string" Value="@category" Color="Color.Primary" Variant="Variant.Outlined" Class="mx-1">
                                @category
                            </MudChip>
                        }
                    </MudChipSet>
            </MudItem>

            <!-- COLUMNA DERECHA -->
            <MudItem xs="12" md="6">

                <MudForm Model="@temporalOrderDTO" OnValidSubmit="UpdateCartAsync">

                    <MudNumericField @bind-Value="temporalOrderDTO!.Quantity"
                                     Label="Cantidad"
                                     Variant="Variant.Outlined"
                                     FullWidth="true"
                                     For="@(() => temporalOrderDTO.Quantity)"
                                     Class="mb-4" />
@*                         <ValidationMessage For="@(() => temporalOrderDTO.Quantity)" />
 *@                    
                    <MudTextField @bind-Value="temporalOrderDTO.Remarks"
                                  Label="Comentarios"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  For="@(() => temporalOrderDTO.Remarks)"
                                  Class="mb-4" />                   
@*                         <ValidationMessage For="@(() => temporalOrderDTO.Remarks)" />
 *@                   

                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Check"
                               ButtonType="ButtonType.Submit">
                        Actualizar Carro de Compras
                    </MudButton>

                </MudForm>
            </MudItem>

        </MudGrid>

        <!-- CARRUSEL / IMÁGENES -->
        <div class="mt-4">
            <CarouselView Images="images" />
        </div>

    </MudCardContent>

</MudCard>
}



