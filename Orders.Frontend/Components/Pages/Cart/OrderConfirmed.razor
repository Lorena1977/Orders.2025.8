@page "/Cart/OrderConfirmed"

 <MudPaper Class="d-flex flex-column align-center justify-center pa-6" Elevation="4" Style="min-height: 70vh;">

    <MudText Typo="Typo.h4" Class="mb-4">Pedido Confirmado</MudText>

    <MudImage Src="Images/Shopping.png" Width="300" Class="mb-4" />

    <MudText Typo="Typo.body1" Class="mb-4">
        Su pedido ha sido confirmado. En breve recibirá sus productos, muchas gracias.
    </MudText>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Home"
               Href="/">
        Volver al inicio
    </MudButton>

</MudPaper>
 