@page "/orders"

@if (Orders is null)
{
    <Loading />
}
else
{
    <MudCard Class="pa-4">

        <!-- HEADER -->
        <MudCardHeader>
            <MudText Typo="Typo.h5">
                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" 
                         Class="mr-2" 
                         Style="font-weight:bold" />
                Pedidos
            </MudText>
        </MudCardHeader>

        <!-- BODY -->
        <MudCardContent>

            <!-- PAGINACIÓN
            <Pagination CurrentPage="currentPage"
                        TotalPages="totalPages"
                        SelectedPage="SelectedPageAsync"
                        RecordsNumber="SelectedRecordsNumberAsync" /> -->


            <MudItem xs="12" Class="d-flex align-items-center">               
                <MudSpacer />
                <div class="d-flex align-items-center">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@(currentPage == 1)"
                               OnClick="() => SelectedPageAsync(currentPage - 1)">
                        Anterior
                    </MudButton>

                    <MudText Typo="Typo.subtitle2" Class="mx-3">@currentPage / @totalPages</MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@(currentPage == totalPages)"
                               OnClick="() => SelectedPageAsync(currentPage + 1)">
                        Siguiente
                    </MudButton>
                </div>
            </MudItem>




            <!-- TABLA -->
            <MudTable Items="Orders" Dense="true" Hover="true" Bordered="true">

                <HeaderContent>
                    <MudTh Style="font-weight:bold">Fecha</MudTh>
                    <MudTh Style="font-weight:bold">Usuario</MudTh>
                    <MudTh Style="font-weight:bold">Comentario</MudTh>
                    <MudTh Style="font-weight:bold">Estado</MudTh>
                    <MudTh Style="font-weight:bold">Líneas</MudTh>
                    <MudTh Style="font-weight:bold">Cantidad</MudTh>
                    <MudTh Style="font-weight:bold">Valor</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd>@($"{context.Date:yyyy/MM/dd hh:mm tt}")</MudTd>
                    <MudTd>@context.User!.FullName</MudTd>
                    <MudTd>@context.Remarks</MudTd>
                    <MudTd>@EnumHelper.GetEnumDescription(context.OrderStatus)</MudTd>
                    <MudTd>@context.Lines</MudTd>
                    <MudTd>@($"{context.Quantity:N2}")</MudTd>
                    <MudTd>@($"{context.Value:C2}")</MudTd>
                    <MudTd>
                        <MudButton Color="Color.Info"
                                   Variant="Variant.Filled"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Info"
                                   Href="@($"/cart/orderDetails/{context.Id}")">                          
                            Detalles
                        </MudButton>
                    </MudTd>
                </RowTemplate>

            </MudTable>

        </MudCardContent>
    </MudCard>
}

