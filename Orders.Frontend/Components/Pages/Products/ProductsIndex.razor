
@page "/products"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@Products"
              @ref="table"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">

        <ToolBarContent>          
            <!-- Línea 1: Título + botón + filtro -->
             <div class="d-flex jflex-row w-100 align-items-center">
                 <MudText Typo="Typo.h6" Class="me-auto">Productos</MudText>
                <MudButton Variant="Variant.Outlined"
                           EndIcon="@Icons.Material.Filled.Add"
                           Color="Color.Info"
                           OnClick="@(() => NavigationManager.NavigateTo($"/products/create/"))">
                    Nuevo Producto
                </MudButton>
                <div class="ms-3">
                <FilterComponent ApplyFilter="ApplyFilterAsync" />
                </div>
            </div>

           @*  <div Class="d-flex flex-row w-100 justify-content-end align-items-center">
                <Pagination CurrentPage="currentPage"
                            TotalPages="totalPages"
                            SelectedPage="SelectedPageAsync"
                            RecordsNumber="SelectedRecordsNumberAsync" />
                <MudSpacer />
            </div> *@
           

        </ToolBarContent>

        <HeaderContent>          
            <MudTh>Nombre</MudTh>
            <MudTh>Descripción</MudTh>
            <MudTh>Precio</MudTh>
            <MudTh>Inventario</MudTh>
            <MudTh>Categorías</MudTh>
            <MudTh>Imágenes</MudTh>
            <MudTh>Imagen Principal</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Name</MudTd>
            <MudTd DataLabel="Descripción">@context.Description</MudTd>
            <MudTd DataLabel="Precio">@($"{context.Price:C2}")</MudTd>
            <MudTd DataLabel="Inventario">@($"{context.Stock:N2}")</MudTd>
            <MudTd DataLabel="Categorías">@context.ProductCategoriesNumber</MudTd>
            <MudTd DataLabel="Imágenes">@context.ProductImagesNumber</MudTd>
            <MudTd DataLabel="Imagen Principal">
                <img src="@context.MainImage" style="width:100px;" />
            </MudTd>
            <MudTd>
                <MudTooltip Text="Editar">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               OnClick="@(() => NavigationManager.NavigateTo($"/products/edit/{context.Id}"))">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" />
                    </MudButton>
                </MudTooltip>
                <MudTooltip Text="Borrar">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               OnClick="@(() => Delete(context.Id))">
                        <MudIcon Icon="@Icons.Material.Filled.Delete" />
                    </MudButton>
                </MudTooltip>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText>No hay productos disponibles</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager RowsPerPageString="Número de registros"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todo"
                           InfoFormat="@infoFormat" />
        </PagerContent>

    </MudTable>
   
}