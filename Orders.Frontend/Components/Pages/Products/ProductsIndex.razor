
@page "/products"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@Products"
              @ref="table"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">

        <ToolBarContent>
            <!-- Línea 1: Título + botón + filtro -->
            <div class="d-flex jflex-row w-100 align-items-center">
                <MudText Typo="Typo.h6" Class="me-auto">Productos</MudText>
                <MudButton Variant="Variant.Outlined"
                           EndIcon="@Icons.Material.Filled.Add"
                           Color="Color.Info"
                           OnClick="@(() => NavigationManager.NavigateTo($"/products/create/"))">
                    Nuevo Producto
                </MudButton>

                <div class="ms-3">
                    <FilterComponent ApplyFilter="ApplyFilterAsync" />
                    <!--<MudTextField Value="SearchText"
                                  ValueChanged="@(async (string value) =>
                                                {
                                                    SearchText = value;
                                                    await FilterCallBack(value);
                                                })"
                              Placeholder="Buscar producto..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                          Class="mb-4" />-->
                </div>
            </div>

            <!-- Línea 2: Paginación (separada con mt-3) -->
          @*   <div class="d-flex flex-row w-100 justify-content-end align-items-center gap-2 mt-3">

                <MudButton Variant="Variant.Filled"
                            Color="Color.Primary"                           
                            Disabled="@(currentPage == 1)"
                            OnClick="@(() => SelectedPageAsync(currentPage - 1))">
                    Anterior
                </MudButton>

                @for (int i = 1; i <= totalPages; i++)
                {
                    var pageNumber = i; 
                    <MudButton Variant="Variant.Outlined"
                               Color="@(i == currentPage ? Color.Primary : Color.Default)"
                               OnClick="@(() => SelectedPageAsync(i))">
                        @pageNumber
                    </MudButton>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(currentPage == totalPages)"
                           OnClick="@(() => SelectedPageAsync(currentPage + 1))">
                    Siguiente
                </MudButton>

            </div> *@

        </ToolBarContent>

        <HeaderContent>
            <MudTh Style="font-weight:bold">Nombre</MudTh>
            <MudTh Style="font-weight:bold">Descripción</MudTh>
            <MudTh Style="font-weight:bold">Precio</MudTh>
            <MudTh Style="font-weight:bold">Inventario</MudTh>
            <MudTh Style="font-weight:bold">Categorías</MudTh>
            <MudTh Style="font-weight:bold">Imágenes</MudTh>
            <MudTh Style="font-weight:bold">Imagen Principal</MudTh>
            <MudTh Style="font-weight:bold">Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Name</MudTd>
            <MudTd DataLabel="Descripción">@context.Description</MudTd>
            <MudTd DataLabel="Precio">@($"{context.Price:C2}")</MudTd>
            <MudTd DataLabel="Inventario">@($"{context.Stock:N2}")</MudTd>
            <MudTd DataLabel="Categorías">@context.ProductCategoriesNumber</MudTd>
            <MudTd DataLabel="Imágenes">@context.ProductImagesNumber</MudTd>
            <MudTd DataLabel="Imagen Principal">
                <img src="@context.MainImage" style="width:100px;" />
            </MudTd>
            <MudTd>
                <MudTooltip Text="Editar">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               OnClick="@(() => NavigationManager.NavigateTo($"/products/edit/{context.Id}"))">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" />
                    </MudButton>
                </MudTooltip>
                <MudTooltip Text="Borrar">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               OnClick="@(() => Delete(context.Id))">
                        <MudIcon Icon="@Icons.Material.Filled.Delete" />
                    </MudButton>
                </MudTooltip>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText>No hay productos disponibles</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager RowsPerPageString="Número de registros"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todo"
                           InfoFormat="@infoFormat" />
        </PagerContent>

    </MudTable>

}
