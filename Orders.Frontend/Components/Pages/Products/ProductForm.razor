<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation"></NavigationLock>

<EditForm EditContext="editContext" OnValidSubmit="OnDataAnnotationsValidatedAsync">
    <DataAnnotationsValidator />

    
    <MudCard Class="mt-4">
        <!-- Header Contiene los botones Guardar Cambios y Regresar-->
        <MudCardHeader>
            <MudText Typo="Typo.h6" Class="me-auto">Crear Nuevo Producto</MudText>
            <MudStack Direction="Row" Spacing="1">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary"
                           ButtonType="ButtonType.Submit"                         
                           StartIcon="@Icons.Material.Filled.Save">                           
                    Guardar Cambios
                </MudButton>
                 <MudButton Variant="Variant.Filled" 
                            Color="Color.Success" 
                            StartIcon="@Icons.Material.Filled.ArrowBack"
                            OnClick="@(() => NavigationManager.NavigateTo("/products"))">
                    Regresar
                </MudButton>
            </MudStack>
        </MudCardHeader>

      <!-- Body -->
        <MudCardContent>
            <MudGrid>
                <!-- Columna izquierda  Contiene los campos del producto->
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="ProductDTO.Name" Label="Nombre" Required="true" For="@(() => ProductDTO.Name)" />
                    <MudTextField @bind-Value="ProductDTO.Description" Label="Descripción" Required="true" For="@(() => ProductDTO.Description)" />
                    <MudNumericField @bind-Value="ProductDTO.Price" Label="Precio" Required="true" For="@(() => ProductDTO.Price)" />
                    <MudNumericField @bind-Value="ProductDTO.Stock" Label="Inventario" Required="true" For="@(() => ProductDTO.Stock)" />
                </MudItem>

                <!-- Columna derecha contiene-->
                <MudItem xs="12" sm="6">
                      <MudText Typo="Typo.subtitle2" Class="mb-2">Categorías:</MudText>
                    <MudText Typo="Typo.body2">
                        <MultipleSelector NonSelected="NonSelected" Selected="Selected" />
                    </MudText>

                    <!-- Subida de imagen -->
                     <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Foto:</MudText>
                      <MudCard Variant="Variant.Outlined" Class="p-2">
                        <MudText Typo="Typo.body2">
                            <InputImg Label="Foto" ImageSelected="ImageSelected" ImageURL="@imageUrl" />
                        </MudText>
                        @if (IsEdit)
                        {
                            <MudStack Direction="Row" Spacing="1">                                
                                <MudButton Variant="Variant.Outlined" 
                                           Color="Color.Primary" 
                                           OnClick="@(() => AddImageAction.InvokeAsync())" 
                                           StartIcon="@Icons.Material.Filled.Add">
                                    Agregar Imagen
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           OnClick="@(() => RemoveImageAction.InvokeAsync())"
                                           StartIcon="@Icons.Material.Filled.Delete">
                                    Eliminar Última Imagen
                                </MudButton>
                            </MudStack>
                        }
                    </MudCard>  
                </MudItem>

            </MudGrid>
        </MudCardContent>
    </MudCard>
</EditForm>

@if (IsEdit && ProductDTO.ProductImages is not null)
{
    <CarouselView Images="ProductDTO.ProductImages" />
}
