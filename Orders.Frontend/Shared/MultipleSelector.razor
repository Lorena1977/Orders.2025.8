<div class="multiple-selector">
    <ul class="selectable-ul">
        @foreach (var item in NonSelected)
        {
            <li @onclick=@(() => Select(item))>@item.Value</li>
        }
    </ul>

     <div class="multiple-selector-botones"> 

        <button type="button" class="mx-2 my-2" @onclick="@(() => SelectAll())">@addAllText</button>

        <button type="button" class="mx-2 my-2" @onclick="@(() => UnselectAll())">@removeAllText</button>
        <button type="button" class="mx-2 my-2" @onclick="TestClick">PRUEBA</button>
    </div>

    <ul class="selectable-ul">
        @foreach (var item in Selected)
        {
            <li @onclick=@(() => Unselect(item))>@item.Value</li>
        }
    </ul>
</div>
